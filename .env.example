# ============================================================
# DATABASE (MySQL)
# ============================================================
# Replace USERNAME, PASSWORD and DATABASE_NAME with your own values.
# Example if your MySQL user is "root", password is "root123" and
# you created a database called "perfume_store":
# DATABASE_URL="mysql://root:root123@localhost:3306/perfume_store"
DATABASE_URL=""mysql://root:admin123@localhost:3306/perfume_store"

# ============================================================
# NEXTAUTH
# ============================================================
# Generate a strong secret with: openssl rand -base64 32
# (On Windows without openssl, use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# DEMO SEED CREDENTIALS (used only by prisma/seed.ts)
# Change these before deploying anywhere public.
# ============================================================
SEED_ADMIN_EMAIL="admin@demo-perfume.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CUSTOMER_EMAIL="customer@demo-perfume.test"
SEED_CUSTOMER_PASSWORD="ChangeMe123!"

# ============================================================
# PAYMENT GATEWAY INTEGRATION POINTS
# ------------------------------------------------------------
# None of these are called by the seed/demo code. They are the
# exact variables the real payment API routes (Stage 5 /
# app/api/payments/*) read from. Leave them blank in development
# if you only want to test Cash on Delivery / Bank Transfer.
# ============================================================

# --- JazzCash (Mobile Account / Page Redirection API) ---
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_ENV="sandbox"                # sandbox | production
JAZZCASH_RETURN_URL="http://localhost:3000/api/payments/jazzcash/callback"

# --- Easypaisa (Open API / MA Payment) ---
EASYPAISA_STORE_ID=""
EASYPAISA_ACCOUNT_NUM=""
EASYPAISA_HASH_KEY=""
EASYPAISA_ENV="sandbox"               # sandbox | production
EASYPAISA_RETURN_URL="http://localhost:3000/api/payments/easypaisa/callback"

# --- Safepay ---
SAFEPAY_API_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_ENV="sandbox"                 # sandbox | production
SAFEPAY_RETURN_URL="http://localhost:3000/api/payments/safepay/callback"
SAFEPAY_WEBHOOK_URL="http://localhost:3000/api/payments/safepay/webhook"

# --- Bank Transfer (manual verification, no external API) ---
BANK_TRANSFER_ACCOUNT_TITLE="Perfume Store (Pvt) Ltd"
BANK_TRANSFER_ACCOUNT_NUMBER=""
BANK_TRANSFER_BANK_NAME=""
BANK_TRANSFER_IBAN=""
